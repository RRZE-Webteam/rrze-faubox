#: includes/Admin/Settings.php:46 includes/Admin/Settings.php:186
msgid "FAUbox Settings"
msgstr "FAUbox Einstellungen"

#: includes/Admin/Settings.php:164
msgid "Your FAUbox WebDAV token has expired. Please generate a new one."
msgstr ""
"Ihr FAUbox-WebDAV-Token ist abgelaufen. Bitte generieren Sie ein neues Token."

#. translators: %d: number of days until token expiry
#: includes/Admin/Settings.php:167
#, php-format
msgid ""
"Your FAUbox WebDAV token expires in %d days. Please generate a new one soon."
msgstr ""
"Ihr FAUbox-WebDAV-Token läuft in %d Tagen ab. Bitte generieren Sie bald ein "
"neues."

#: includes/Admin/Settings.php:187
msgid ""
"Enter your FAUbox WebDAV credentials. You can generate them in your FAUbox "
"account under \"My Account\" →\n"
"   \"Devices\" → \"Add WebDAV connection\"."
msgstr ""
"Geben Sie Ihre FAUbox-WebDAV-Anmeldedaten ein. Diese generieren Sie in Ihrem "
"FAUbox-Konto unter „Mein Konto“ →\n"
"   „Geräte“ → „WebDAV-Verbindung hinzufügen“."

#: includes/Admin/Settings.php:201
msgid "FAUbox Username"
msgstr "FAUbox Benutzername"

#: includes/Admin/Settings.php:215
msgid "FAUbox WebDAV Token"
msgstr "FAUbox WebDAV Token"

#: includes/Admin/Settings.php:228
msgid "Token created on"
msgstr "Token erstellt am"

#: includes/Admin/Settings.php:248
msgid "Token has expired!"
msgstr "Das Token ist abgelaufen!"

#: includes/Admin/Settings.php:251
#, php-format
msgid "Expires in %d days — please renew soon."
msgstr "Läuft in %d Tagen ab – bitte bald verlängern."

#: includes/Admin/Settings.php:254
#, php-format
msgid "Token validity: 1 year. Valid for %d more days (until %s)."
msgstr "Gültigkeitsdauer des Tokens: 1 Jahr. Noch %d Tage gültig (bis %s)."

#: includes/Admin/Settings.php:269
msgid "FAUbox Main Folder"
msgstr "FAUbox Stammordner"

#: includes/Admin/Settings.php:279
msgid ""
"The main folder whose subfolders are to be displayed in the block editor."
msgstr ""
"Der Stammordner, dessen Unterordner im Block-Editor angezeigt werden sollen."

#: includes/Admin/Settings.php:283
msgid "No main folder configured — the plugin will not display any files."
msgstr ""
"Es wurde kein Stammordner konfiguriert – das Plugin zeigt keine Dateien an."

#: includes/Admin/Settings.php:291
msgid "Index cache duration"
msgstr "Dauer des Index-Caches"

#: includes/Admin/Settings.php:305
msgid ""
"Cache duration of the folder index. The index is rebuilt automatically when "
"credentials or folder settings change. "
msgstr ""
"Cache-Dauer des Ordnerindexes. Der Index wird automatisch neu erstellt, wenn "
"sich Anmeldedaten oder Ordnereinstellungen ändern. "

