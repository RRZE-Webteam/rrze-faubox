msgid "Last modified"
msgstr "Zuletzt geändert"

#: includes/Rest/RestController.php:112
msgid "No main folder configured. Please set it in the FAUbox settings."
msgstr ""
"Ordnerauswahl fehlt. Bitte wähle den darzustellenden Ordner in den "
"Blockeinstellungen der Seitenleiste."

#: includes/Rest/RestController.php:121
msgid ""
"The folder index has not been built yet. Please save the FAUbox settings or "
"refresh the index manually."
msgstr ""
"Der Ordnerindex wurde noch nicht erstellt. Bitte speichern Sie die FAUbox-"
"Einstellungen oder aktualisieren Sie den Index manuell."

#: includes/Rest/RestController.php:133
msgid "Could not retrieve folders. Please check your FAUbox credentials."
msgstr ""
"Die Ordner konnten nicht geladen werden. Bitte überprüfe deine FAUbox "
"Einstellungen."

#: includes/Rest/RestController.php:154
msgid "Please wait before refreshing again."
msgstr "Bitte warte , bevor du die Seite erneut aktualisierst."

#. translators: 1: Server PHP version number, 2: Required PHP version number.
#: rrze-faubox.php:75
#, php-format
msgid ""
"The server is running PHP version %1$s. The Plugin requires at least PHP "
"version %2$s."
msgstr ""
"Auf dem Server läuft PHP-Version %1$s. Das Plugin erfordert mindestens PHP-"
"Version %2$s."

#. translators: 1: Server WordPress version number, 2: Required WordPress version number.
#: rrze-faubox.php:82
#, php-format
msgid ""
"The server is running WordPress version %1$s. The Plugin requires at least "
"WordPress version %2$s."
msgstr ""
"Auf dem Server läuft WordPress Version %1$s. Das Plugin erfordert mindestens "
"WordPress Version %2$s."

