#: includes/Admin/Settings.php:51 includes/Admin/Settings.php:261
msgid "FAUbox Settings"
msgstr "FAUbox Einstellungen"

#: includes/Admin/Settings.php:189
msgid "Your FAUbox WebDAV token has expired. Please generate a new one."
msgstr ""
"Dein FAUbox-WebDAV-Token ist abgelaufen. Bitte generiere ein neues Token."

#. translators: %d: number of days until token expiry
#: includes/Admin/Settings.php:192
#, php-format
msgid ""
"Your FAUbox WebDAV token expires in %d days. Please generate a new one soon."
msgstr ""
"Dein FAUbox-WebDAV-Token läuft in %d Tagen ab. Bitte generiere bald ein "
"neues."

#: includes/Admin/Settings.php:236
msgid "Insufficient permissions."
msgstr "Unzureichende Berechtigungen."

#: includes/Admin/Settings.php:257
msgid "Folder index has been refreshed."
msgstr "Der Ordnerindex wurde aktualisiert."

#: includes/Admin/Settings.php:262
msgid ""
"Enter your FAUbox WebDAV credentials. You can generate them in your FAUbox "
"account under \"My Account\" → \"Devices\" → \"Add WebDAV connection\"."
msgstr ""
"Gib deine FAUbox-WebDAV-Anmeldedaten ein. Diese generierst du in deinem "
"FAUbox-Konto unter „Mein Konto“ → „Geräte“ → „WebDAV-Verbindung hinzufügen“."

#: includes/Admin/Settings.php:275
msgid "FAUbox Username"
msgstr "FAUbox Benutzername"

#: includes/Admin/Settings.php:289
msgid "FAUbox WebDAV Token"
msgstr "FAUbox WebDAV Token"

#: includes/Admin/Settings.php:302
msgid "Token created on"
msgstr "Token erstellt am"

#: includes/Admin/Settings.php:312
msgid "Your token has expired - please renew!"
msgstr ""
"Dein FAUbox-WebDAV-Token ist abgelaufen. Bitte generiere ein neues Token!"

#: includes/Admin/Settings.php:316
#, php-format
msgid "Your token expires in %d days — please renew soon."
msgstr "Läuft in %d Tagen ab – bitte bald verlängern."

#: includes/Admin/Settings.php:320
#, php-format
msgid "Token validity: 1 year. Valid for %d more days (until %s)."
msgstr "Gültigkeitsdauer des Tokens: 1 Jahr. Noch %d Tage gültig (bis %s)."

#: includes/Admin/Settings.php:335
msgid "FAUbox Main Folder"
msgstr "FAUbox Stammordner"

#: includes/Admin/Settings.php:345
msgid ""
"The main folder whose subfolders are to be displayed in the block editor."
msgstr ""
"Der Stammordner, dessen Unterordner im Block-Editor angezeigt werden sollen."

#: includes/Admin/Settings.php:349
msgid "No main folder configured — the plugin will not display any files."
msgstr ""
"Es wurde kein Stammordner konfiguriert – das Plugin zeigt keine Dateien an."

#: includes/Admin/Settings.php:357
msgid "Index cache duration"
msgstr "Dauer des Index-Caches"

#: includes/Admin/Settings.php:370
msgid ""
"Cache duration of the folder index. The index is rebuilt automatically when "
"credentials or folder settings change. "
msgstr ""
"Cache-Dauer des Ordnerindexes. Der Index wird automatisch neu erstellt, wenn "
"sich Anmeldedaten oder Ordnereinstellungen ändern. "

#: includes/Admin/Settings.php:378
msgid "Folder Index"
msgstr "Ordnerindex"

#: includes/Admin/Settings.php:379
msgid ""
"Manually refresh the folder index if the folder structure in FAUbox has "
"changed."
msgstr ""
"Den Ordnerindex manuell aktualisieren, falls sich die Ordnerstruktur "
"geändert hat."

#: includes/Admin/Settings.php:383
msgid "Refresh index now"
msgstr "Index jetzt aktualisieren"

#: includes/API/DownloadService.php:42 includes/API/DownloadService.php:45
msgid "Invalid file path."
msgstr "Ungültiger Dateipfad."

#: includes/API/DownloadService.php:50
msgid "No folder configured."
msgstr "Es ist kein Ordner konfiguriert."

#: includes/API/DownloadService.php:54
msgid "Access denied."
msgstr "Zugriff verweigert."

#: includes/API/DownloadService.php:60
msgid "Invalid request."
msgstr "Ungültige Anfrage."

#: includes/API/DownloadService.php:65
msgid "File not found."
msgstr "Keine Datei gefunden."

#: includes/Blocks/BlockRegistration.php:65
msgid "RRZE"
msgstr "RRZE"

