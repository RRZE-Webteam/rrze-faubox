msgid "No files found."
msgstr "Keine Dateien gefunden."

#: includes/Frontend/Renderer.php:91 includes/Frontend/Renderer.php:156
msgid "(opens in new tab)"
msgstr "(öffnet in einem neuen Tab)"

#: includes/Frontend/Renderer.php:135
msgid "FAUbox files"
msgstr "FAUbox Dateien"

#: includes/Helper.php:19
msgid "File Name"
msgstr "Dateiname"

