{
  "name": "rrze-faubox",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "devDependencies": {
    "@types/wordpress__block-editor": "^11.5.16",
    "@types/wordpress__blocks": "^12.5.18",
    "@wordpress/block-editor": "^15.6.0",
    "@wordpress/block-library": "^9.34.0",
    "@wordpress/blocks": "^15.6.0",
    "@wordpress/scripts": "^30.26.0",
    "sass": "^1.94.0",
    "typescript": "^5.8.2"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "wp-scripts build && npm run build-style",
    "start": "wp-scripts start",
    "build-style": "sass src/block/style.scss build/block/style.css --no-source-map --style=compressed",
    "i18n:php": "wp i18n make-pot . languages/rrze-faubox-php.pot --exclude=node_modules,build,vendor --domain=rrze-faubox",
    "i18n:block": "wp-scripts i18n src --output-file=languages/rrze-faubox-block.pot",
    "i18n:merge": "wp i18n make-pot . languages/rrze-faubox.pot --exclude=node_modules,build,vendor --domain=rrze-faubox --merge=languages/rrze-faubox-block.pot",
    "i18n:json": "wp i18n make-json languages --no-purge",
    "i18n:all": "npm run i18n:php && npm run i18n:block && npm run i18n:merge && npm run i18n:json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RRZE-Webteam/rrze-faubox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RRZE-Webteam/rrze-faubox/issues"
  },
  "homepage": "https://github.com/RRZE-Webteam/rrze-faubox#readme"
}
